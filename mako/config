# Black-White — Mako notification theme
# Black background, white text, subtle gray border.

font=Roboto 10
background-color=#080808
text-color=#ffffff
border-color=#383838
border-size=1
border-radius=8
padding=12
margin=12
width=360
height=110
anchor=top-right
layer=overlay
max-visible=5
default-timeout=5000
ignore-timeout=0
icons=1
max-icon-size=48
markup=1
format=<b>%s</b>\n%b
progress-color=over #ffffff
